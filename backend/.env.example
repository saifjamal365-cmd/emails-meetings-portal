# Copy this file to ".env" and fill in the real values.
# ".env" is git-ignored and must never be committed.
# Everything here is FREE. Only the lines without "#" need a value.

# --- Google Gemini (the LLM, free tier) -----------------------------------
# Get a free key: https://aistudio.google.com/apikey  (no payment needed)
# Note: on the free tier Google may use what you send (email and meeting text)
# to improve its products.
GEMINI_API_KEY=

# Optional (defaults are in app/config.py):
# LLM_MODEL=gemini-3.1-flash-lite       # the main model
# LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash  # when busy or used up
# LLM_MIN_SECONDS_BETWEEN_CALLS=6       # space between calls, to stay under the free limits

# --- Portal login ---------------------------------------------------------
# The password for the portal (you choose it). Empty = no login (development only).
PORTAL_PASSWORD=

# --- Google account: Gmail + Calendar (free) -------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI:  http://localhost:8000/api/auth/google/callback
# Leave empty until you connect Google; the portal works without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Everything below is optional: the defaults work -----------------------

# Keys created automatically in backend/data/ when empty
# SESSION_SECRET=
# TOKEN_ENCRYPTION_KEY=
# SESSION_DAYS=7

# Email agent
# EMAIL_SYNC_MINUTES=5          # check Gmail every N minutes (0 = only the Refresh button)
# EMAIL_SYNC_MAX=50             # max unread emails per check
# EMAIL_MAX_CHARS_FOR_LLM=6000  # longer emails are cut before the LLM reads them

# Meeting agent (auto-summarize is switched on in Settings)
# MEETING_SYNC_MINUTES=10       # check for new transcripts every N minutes (0 = off)

# Meeting recorder (switched on in Settings -> Auto-record)
# WHISPER_MODEL=large-v3-turbo   # best Arabic; small = faster but weak Arabic
# WHISPER_LANGUAGE=ar           # main meeting language; empty = guess (can go wrong)
# RECORD_MAX_EXTRA_MINUTES=30    # keep recording after the calendar end while people talk
# KEEP_RECORDINGS=false          # keep the audio files after the transcript is made
# SPEAKER_SEPARATION=true        # split the other people's voices: "Speaker 1", "Speaker 2" ...
# SPEAKER_THRESHOLD=0.5          # smaller = more speakers (one person may get two labels)

# Daily planner
# MORNING_PLAN_HOUR=8           # morning plan at 8:00 (-1 = off)
# EVENING_SUMMARY_HOUR=18       # end-of-day summary at 18:00 (-1 = off)

# Database and files
# DATA_DIR=                     # default: backend/data
# DATABASE_URL=                 # default: SQLite file in DATA_DIR

# Portal address (the React dev server)
# FRONTEND_ORIGIN=http://localhost:5173

# Production only (a cloud server)
# ENVIRONMENT=production        # needs PORTAL_PASSWORD; secure cookies; serves the built portal
